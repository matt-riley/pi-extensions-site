# Shared look for every clip. Each tape still sets its own Output and TypingSpeed.
Set Shell zsh
Set FontFamily "Menlo, Symbols Nerd Font Mono"
Set FontSize 22
Set Width 1600
Set Height 900
Set Padding 28
Set Framerate 30
Set CursorBlink false
Set Theme { "name": "pi-ink", "background": "#101216", "foreground": "#ebe7de", "cursor": "#ffb000", "selection": "#2a2e35", "black": "#1b1e24", "red": "#ff6b5b", "green": "#9bd17a", "yellow": "#ffb000", "blue": "#7fb4ff", "magenta": "#d79bff", "cyan": "#6fd6d0", "white": "#ebe7de", "brightBlack": "#8d8c86", "brightRed": "#ff8a7d", "brightGreen": "#b4e398", "brightYellow": "#ffc94d", "brightBlue": "#a3c9ff", "brightMagenta": "#e6bbff", "brightCyan": "#97e6e1", "brightWhite": "#ffffff" }
